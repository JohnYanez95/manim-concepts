# --- Render output: never in git ---------------------------------------------
# Every video in this repo is reproducible from its source module in one command.
# Committing renders would make the repo grow without bound and turn every
# re-render into a binary diff.
media/
*.mp4
*.gif
*.mov
*.png
*.svg
!docs/**/*.png
!docs/**/*.svg
# The README's welcome animation is the one committed render: small,
# palette-optimized, and regenerated from docs/assets/welcome_scene.py.
!docs/assets/welcome.gif

# --- Environments --------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/

# --- LaTeX build artifacts (MathTex shells out to latex) -----------------------
*.aux
*.dvi
*.fls
*.fdb_latexmk
*.synctex.gz
# Study-guide intermediates; the outcome PDFs in the objective
# subdirectories ARE committed (plan 012 D-A) — only the scratch is not.
study_guides/**/*.log
study_guides/**/*.out
study_guides/**/*.toc
study_guides/**/*.bbl
study_guides/**/*.bcf
study_guides/**/*.blg
study_guides/**/*.run.xml

# --- Editor / OS ---------------------------------------------------------------
# WSL writes a :Zone.Identifier alternate-data-stream file next to anything
# downloaded on the Windows side. Pure metadata, never content.
*:Zone.Identifier
.DS_Store
*.swp

# --- Agent workspace -----------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md
